  availableSkills:
  - type: 0
    name: "\u0423\u0432\u0435\u043B\u0438\u0447\u0435\u043D\u0438\u0435 \u0441\u043A\u043E\u0440\u043E\u0441\u0442\u0438"
    description: "\u0423\u0432\u0435\u043B\u0438\u0447\u0438\u0432\u0430\u0435\u0442
      \u0441\u0438\u043B\u0443 \u0434\u0432\u0438\u0433\u0430\u0442\u0435\u043B\u044F
      \u043D\u0430 \u043E\u043F\u0440\u0435\u0434\u0435\u043B\u0435\u043D\u043D\u044B\u0439
      \u043F\u0440\u043E\u0446\u0435\u043D\u0442."
  - type: 1
    name: "\u0423\u0432\u0435\u043B\u0438\u0447\u0435\u043D\u0438\u0435 \u0431\u0430\u043A\u0430"
    description: "\u0423\u0432\u0435\u043B\u0438\u0447\u0438\u0432\u0430\u0435\u0442
      \u043C\u0430\u043A\u0441\u0438\u043C\u0430\u043B\u044C\u043D\u044B\u0439 \u043E\u0431\u044A\u0435\u043C
      \u0442\u043E\u043F\u043B\u0438\u0432\u0430, \u043D\u043E \u0441\u043D\u0438\u0436\u0430\u0435\u0442
      \u0441\u043A\u043E\u0440\u043E\u0441\u0442\u044C."
  - type: 2
    name: "\u0411\u043E\u043B\u044C\u0448\u0438\u0435 \u043A\u043E\u043B\u0435\u0441\u0430"
    description: "\u0423\u0432\u0435\u043B\u0438\u0447\u0438\u0432\u0430\u0435\u0442
      \u0440\u0430\u0437\u043C\u0435\u0440 \u043A\u043E\u043B\u0435\u0441, \u0443\u043B\u0443\u0447\u0448\u0430\u044F
      \u0444\u0438\u0437\u0438\u043A\u0443."
  - type: 3
    name: "\u0421\u043D\u0438\u0436\u0435\u043D\u0438\u0435 \u0433\u0440\u0430\u0432\u0438\u0442\u0430\u0446\u0438\u0438"
    description: "\u0423\u043C\u0435\u043D\u044C\u0448\u0430\u0435\u0442 \u0433\u043B\u043E\u0431\u0430\u043B\u044C\u043D\u0443\u044E
      \u0433\u0440\u0430\u0432\u0438\u0442\u0430\u0446\u0438\u044E."
  - type: 4
    name: "\u0429\u0438\u0442"
    description: "\u0414\u043E\u0431\u0430\u0432\u043B\u044F\u0435\u0442 \u043E\u0434\u043D\u0443
      \u0436\u0438\u0437\u043D\u044C."
  - type: 5
    name: "\u0411\u043E\u043B\u044C\u0448\u0435 \u043E\u0447\u043A\u043E\u0432"
    description: "\u0423\u0432\u0435\u043B\u0438\u0447\u0438\u0432\u0430\u0435\u0442
      \u043D\u0430\u043A\u043E\u043F\u043B\u0435\u043D\u043D\u044B\u0435 \u0434\u0435\u043D\u044C\u0433\u0438."
  - type: 6
    name: "\u0421\u043C\u0435\u0440\u0442\u0435\u043B\u044C\u043D\u043E\u0435 \u0443\u0441\u043A\u043E\u0440\u0435\u043D\u0438\u0435"
    description: "\u0412\u0440\u0435\u043C\u0435\u043D\u043D\u043E \u0443\u0434\u0432\u0430\u0438\u0432\u0430\u0435\u0442
      \u0441\u043A\u043E\u0440\u043E\u0441\u0442\u044C."
  - type: 7
    name: "\u0423\u043B\u0443\u0447\u0448\u0435\u043D\u0438\u0435 \u0441\u0446\u0435\u043F\u043B\u0435\u043D\u0438\u044F"
    description: "\u0423\u0432\u0435\u043B\u0438\u0447\u0438\u0432\u0430\u0435\u0442
      \u0441\u0446\u0435\u043F\u043B\u0435\u043D\u0438\u0435 \u043A\u043E\u043B\u0435\u0441."
